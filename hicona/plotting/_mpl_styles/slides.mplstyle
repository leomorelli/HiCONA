# Style sheet for generic slides-like presentation
# NOTE: Fontsizes are eyeballed to look good, with not particular reason.

# ***************************************************************************
# * FONT                                                                    *
# ***************************************************************************

font.family: sans-serif
font.sans-serif: Arial
font.size: 16.0

# ***************************************************************************
# * AXES                                                                    *
# ***************************************************************************

# axes.labelsize: 10.0

# ***************************************************************************
# * TICKS                                                                   *
# ***************************************************************************

xtick.labelsize: 8.0
ytick.labelsize: 8.0

# ***************************************************************************
# * FIGURE                                                                  *
# ***************************************************************************

figure.dpi: 450
