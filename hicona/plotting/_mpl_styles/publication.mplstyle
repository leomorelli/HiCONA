# Style sheet for Nature-like publication style
# https://research-figure-guide.nature.com/figures/preparing-figures-our-specifications/
# NOTE: does probably not cover all points but at least the most common ones.


# ***************************************************************************
# * FONT                                                                    *
# ***************************************************************************

font.family: sans-serif
font.sans-serif: Arial
font.size: 6.0

# ***************************************************************************
# * AXES                                                                    *
# ***************************************************************************

# axes.labelsize: 6.0
axes.linewidth: 0.5


# ***************************************************************************
# * TICKS                                                                   *
# ***************************************************************************

xtick.labelsize: 6.0
ytick.labelsize: 6.0

ytick.major.size: 1.5
ytick.major.pad: 1.0

# ***************************************************************************
# * FIGURE                                                                  *
# ***************************************************************************

figure.dpi: 450
