{
    "conventions": {
        "chrom_lists": {
            "humanCanonical": "1-22,X,Y",
            "mouseCanonical": "1-19,X,Y"
        },
        "dtype_conversion": {
            "int32": "int",
            "int64": "long",
            "float64": "long double",
            "object": "string",
            "bool": "bool"
        },
        "table_columns": {
            "bin1_id": "i8",
            "bin2_id": "i8",
            "count": "i4",
            "exp_ratio": "f8",
            "alpha_min": "f8",
            "alpha_max": "f8"
        },
        "table_uri_template": "distThr_{}_countThr_{}_quantThr_{}"
    },
    "parameters": {
        "base_pix_chunk": 1000000,
        "lock_delay": 0.3,
        "max_annot_mods": 10,
        "min_pix_chunk": 1000000
    },
    "regexes": {
        "genomic_region": "^chr([0-9]{1,2}|X|Y|MT):(\\d+)-(\\d+)$",
        "single_chromosome": "^chr([0-9]{1,2}|X|Y|MT)$"
    }
}